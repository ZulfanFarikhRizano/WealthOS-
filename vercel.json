{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ],
  "functions": {
    "api/market.js":        { "maxDuration": 30 },
    "api/notifications.js": { "maxDuration": 30 },
    "api/news_api.js":      { "maxDuration": 20 },
    "api/ai.js":            { "maxDuration": 60 },
    "api/proxy.js":         { "maxDuration": 15 }
  }
}
